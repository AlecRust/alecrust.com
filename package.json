{
  "name": "alecrust.com",
  "version": "1.0.0",
  "private": true,
  "author": "Alec Rust (https://www.alecrust.com/)",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "webpack serve",
    "build": "webpack --mode production",
    "test": "playwright test",
    "lint": "biome lint . && stylelint '**/*.css'",
    "format": "biome check --write . && stylelint --fix '**/*.css'",
    "prepare": "husky"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "normalize.css": "^8.0.1",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "responsive-loader": "^3.1.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.2",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.css": "stylelint --fix"
  }
}
